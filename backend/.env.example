# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_ENABLED=true

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=colored
LOG_TO_FILE=false
LOG_FILE=

# Reddit API (Optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# AWS Settings (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── LLM / AI features ───────────────────────────────────────────────
# AI features (RAG chat, tool agent, content generator) get their CHAT client from
# get_llm_client() and their EMBEDDINGS client from get_embed_client() (app.core.llm)
# — both speak the OpenAI wire protocol. Chat and embeddings are configured
# INDEPENDENTLY, because Ollama Cloud serves chat but has NO embeddings endpoint.
#
# LLM_PROVIDER: "ollama" | "openai" | "" (auto — OpenAI when OPENAI_API_KEY is set,
# otherwise Ollama).
LLM_PROVIDER=

# Chat — Ollama. Local dev: `ollama serve` + `ollama pull llama3.2`.
# Prod (Ollama Cloud): OLLAMA_BASE_URL=https://ollama.com/v1, an OLLAMA_API_KEY from
# https://ollama.com/settings/keys, and a cloud model (e.g. gpt-oss:120b).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=llama3.2

# Embeddings — a dedicated endpoint (Ollama Cloud has none). Empty EMBED_BASE_URL
# falls back to OLLAMA_BASE_URL (local dev: one Ollama serves both). In prod the
# Docker image runs a local Ollama "sidecar" for embeddings, so the image defaults
# EMBED_BASE_URL to http://localhost:11434/v1 while chat points at the cloud.
EMBED_BASE_URL=
EMBED_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text

# Alternative chat provider — OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
